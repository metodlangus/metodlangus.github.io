lay: none; padding: 1em 0px; text-align: center;\">\n    <img\n      alt=\"\"\n      height=\"400\"\n      src=\"data:image/svg+xml;charset=UTF-8,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%27600%27%20height%3D%27400%27%20viewBox%3D%270%200%20600%20400%27%3E%3Crect%20width%3D%27100%25%27%20height%3D%27100%25%27%20fill%3D%27transparent%27%2F%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2740%25%27%20dominant-baseline%3D%27middle%27%20text-anchor%3D%27middle%27%20font-family%3D%27%22Times%20New%20Roman%22%2C%20serif%27%20font-size%3D%2736%27%20fill%3D%27gray%27%3E2.%20dan%3C%2Ftext%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2755%25%27%20dominant-baseline%3D%27middle%27%20text-anchor%3D%27middle%27%20font-family%3D%27%22Times%20New%20Roman%22%2C%20serif%27%20font-size%3D%2730%27%20fill%3D%27gray%27%3EBreiter%20Kopf%20(1558%20m),%20Ganges%20(1732%20m),%3C%2Ftext%3E%3Ctext%20x%3D%2750%25%27%20y%3D%2765%25%27%20dominant-baseline%3D%27middle%27%20text-anchor%3D%27middle%27%20font-family%3D%27%22Times%20New%20Roman%22%2C%20serif%27%20font-size%3D%2730%27%20fill%3D%27gray%27%3EDobratsch%20(2166%20m)%3C%2Ftext%3E%3C%2Fsvg%3E\"\n      width=\"600\"\n    />\n  </a>\n</div>\n\n<script>\n  <!-- Insert another post container via title -->\n  <!-- Breiter Kopf (1558 m), Ganges (1732 m), Dobratsch (2166 m) -->\n    var postTitle0 = '2050129219629513024';\n</script>\n\n<script>\n  <!-- Insert another post images via ID -->\n  <!-- Breiter Kopf (1558 m), Ganges (1732 m), Dobratsch (2166 m) -->\n    var postID1 = '2050129219629513024';\n</script>\n\n<script>\n  <!-- Insert image slideshow via title -->\n    var slideshowTitle0 = 'Make trip slideshow';\n    var CoverPhoto0 = 'https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEi3eLjav6Uu5MCpgjZpvURlZZEW4wj3zOmatI_sYx9_JENm_M7TkOqPEL9SKWbtqoBeTuBgSUxA_1b-cvO3E42Vt9UuckSyoGIZZtj_QcojxYuKtXg7IkfCMkxqnRjfHCpPtp3KHIXQvkpW3QZFRSgxRogl3yI-8xIsaxN4IMMhGqF0XK9uQMEPBtUWJ5U/s1200/20260815_172707687.JPG';\n</script>\n"
